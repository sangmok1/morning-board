<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:padding="16dp">

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_icon" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="fitCenter" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="38sp" android:textStyle="bold" android:text="--°" />
                <TextView android:id="@+id/w_desc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#BAC0CC" android:textSize="14sp" android:text="날씨 불러오는 중" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/w_outfit" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="10dp" android:scaleType="fitStart" android:adjustViewBounds="true" />
        <TextView android:id="@+id/w_outfit_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp">
        <TextView android:id="@+id/bus_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#BAC0CC" android:textSize="14sp" android:maxLines="1" android:text="버스 도착" />
        <TextView android:id="@+id/bus_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:textColor="#868E9C" android:textSize="15sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/bus_row1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
            <TextView android:id="@+id/bus_route1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="64dp" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/bus_eta1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:textColor="#FFD43B" android:textSize="18sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bus_row2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
            <TextView android:id="@+id/bus_route2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="64dp" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/bus_eta2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:textColor="#FFD43B" android:textSize="18sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bus_row3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
            <TextView android:id="@+id/bus_route3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="64dp" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/bus_eta3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:textColor="#FFD43B" android:textSize="18sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bus_row4" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
            <TextView android:id="@+id/bus_route4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="64dp" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/bus_eta4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:textColor="#FFD43B" android:textSize="18sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bus_row5" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
            <TextView android:id="@+id/bus_route5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="64dp" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/bus_eta5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:textColor="#FFD43B" android:textSize="18sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bus_row6" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
            <TextView android:id="@+id/bus_route6" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="64dp" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/bus_eta6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:textColor="#FFD43B" android:textSize="18sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="#868E9C" android:textSize="12sp" />
            <TextView android:id="@+id/w_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="6dp" android:textColor="#FFFFFF" android:textSize="15sp" android:text="↻ 새로고침" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
